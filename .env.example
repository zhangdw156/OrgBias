# Default local Codex model; a plan selection changes only the tested agent.
ORIBIAS_LLM_BASE_URL=http://localhost:4141/v1
ORIBIAS_LLM_API_KEY=replace-with-your-local-provider-key
ORIBIAS_LLM_MODEL=gpt-6.1-sol
ORIBIAS_LLM_EFFORT=medium

# Independent rubric judge. API_KEY falls back to ORIBIAS_LLM_API_KEY if omitted.
ORIBIAS_JUDGE_BASE_URL=http://localhost:4141/v1
ORIBIAS_JUDGE_MODEL=gpt-6.1-sol
ORIBIAS_JUDGE_EFFORT=medium
ORIBIAS_JUDGE_CONTEXT_TOKENS=1050000
ORIBIAS_JUDGE_MAX_PROMPT_TOKENS=922000

# Independent Ark accounts; keys stay on the host. URLs use the Anthropic base;
# the Codex integration appends /v3 for the documented Responses interface.
ORIBIAS_ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
ORIBIAS_ARK_CODING_API_KEY=replace-with-coding-plan-key
ORIBIAS_ARK_PLAN_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
ORIBIAS_ARK_PLAN_API_KEY=replace-with-agent-plan-key
ORIBIAS_ARK_DEFAULT_MODEL=glm-5.3
ORIBIAS_ARK_EFFORT=medium
ORIBIAS_MATRIX_CONCURRENCY=2
# Optional comma-separated subset; otherwise all named models in ark_models.json.
# ORIBIAS_ARK_MODELS=glm-5.3,glm-5.3-flash

# Local Codex ASP; `run` starts/stops it automatically if it is not already running.
ORIBIAS_ASP_URL=http://127.0.0.1:8765
ORIBIAS_ASP_TOKEN=replace-with-a-local-service-token
ORIBIAS_CODEX_BIN=codex
ORIBIAS_RUN_TIMEOUT=300
ORIBIAS_WEB_SEARCH=live

# 4141 /models advertises these limits for gpt-6.1-sol; change with the model.
ORIBIAS_CONTEXT_TOKENS=1050000
ORIBIAS_MAX_PROMPT_TOKENS=922000
ORIBIAS_JUDGE_OUTPUT_TOKENS=16384
